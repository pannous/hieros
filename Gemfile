source "https://rubygems.org"

# Used by .github/workflows/jekyll-gh-pages.yml to build docs/ (the
# hieros.wiki submodule) directly with Jekyll instead of the opaque
# github-pages meta-gem, which bundles jekyll-github-metadata and stalls
# out for 10+ minutes on this repo's size (~4900 pages, 13000+ commits).
gem "jekyll", "~> 3.10"
gem "minima", "~> 2.5"
gem "kramdown-parser-gfm"

gem "jekyll-relative-links"
gem "jekyll-optional-front-matter"
gem "jekyll-readme-index"
gem "jekyll-default-layout"
gem "jekyll-titles-from-headings"
gem "jekyll-paginate"
gem "jekyll-feed"
gem "jekyll-seo-tag"
gem "jekyll-coffeescript"
gem "jekyll-commonmark-ghpages"
gem "jekyll-gist"

gem "webrick"
